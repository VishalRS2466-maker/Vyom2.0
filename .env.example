# GEMINI_API_KEY: Required for Gemini AI Catastrophe Copilot & Vector RAG calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
# You can also configure this directly in the VYOM Settings UI at runtime.
VITE_SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_ANON_KEY: Your Supabase Public/Anon Key (never use service_role in client)
# Configurable also inside the in-app Settings panel.
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
